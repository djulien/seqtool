{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seqtool:schema:common:1",
  "title": "seqtool common definitions",
  "$defs": {
    "seconds": {"type": "number", "minimum": 0, "description": "Seconds from start of audio"},
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "unitMap": {"type": "object", "additionalProperties": {"$ref": "#/$defs/unit"},
                "description": "Open vocabulary -> 0..1 score; unknown keys are ignored by consumers"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {
      "type": "object", "required": ["name", "version"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
    },
    "inputRef": {
      "type": "object", "required": ["schema", "schema_version", "content_sha256"],
      "properties": {
        "schema": {"type": "string"},
        "schema_version": {"$ref": "#/$defs/version"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "filename": {"type": "string"}
      }
    },
    "fileRef": {
      "type": "object", "required": ["filename", "sha256"],
      "properties": {"filename": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "timedEvent": {
      "type": "object", "required": ["time"],
      "properties": {"time": {"$ref": "#/$defs/seconds"}, "strength": {"$ref": "#/$defs/unit"}}
    },
    "envelope": {
      "type": "object",
      "required": ["schema", "schema_version", "producer", "created_utc", "source"],
      "properties": {
        "schema": {"type": "string"},
        "schema_version": {"$ref": "#/$defs/version"},
        "producer": {"$ref": "#/$defs/producer"},
        "created_utc": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"},
        "source": {"type": "object"}
      }
    }
  }
}
